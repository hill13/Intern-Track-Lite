# Database — local docker-compose default
DATABASE_URL=postgresql+asyncpg://intern:intern@db:5432/interntrack

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Transactional email (Resend) — required for reminder digests
RESEND_API_KEY=re_your_key_here

# CORS — comma-separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:5173
